#!/usr/bin/env python

import re

from soundex import Soundex

import sys

import tkinter
from tkinter.constants import *
from tkinter import font
from tkinter import scrolledtext

## constants
supportedPunct={"period":".", "exclam":"!", "comma":",", "plus":"+", "minus":"-", "slash":"/", "colon":":", "semicolon":";", "question":"?", "apostrophe":"'", "Return":"\n"}
punctPat=re.compile("[^A-Za-z0-9']")
alpha="abcdefghijklmnopqrstuvwxyz"
rainbow=["red", "orange", "brown", "limegreen", "blue", "indigo", "violet"]

## configurable
# TODO: pull these out of a config file
sidebarScaleFactor=6
currentScaleFactor=3
scrollFontSize=12
scrollWidth=80
scrollFontFamily="Fixed"
debugLevel=1

## data structures
soundex=Soundex()

stream = [] # TODO: stream should become 2-dimensional: line and word. This lets us optimize redraw by redrawing only the line, and also lets us highlight the current line.
lexicon = {}
sLexicon = {}
topPositionCount = 0 # used for scaling word frequencies

def dprint(s, level=1):
  if debugLevel>=level:
    print(s)
def isPunct(w):
  return re.fullmatch(punctPat, w) is not None
def canonicalize(w):
  word=str(w).lower().strip()
  if(w=="\n"): word="\n"
  canonical=word
  canonicalCap=word.capitalize()
  punct=isPunct(word)
  if not punct:
    canonical=" "+canonical
    canonicalCap=" "+canonicalCap
  return (word, canonical, canonicalCap, punct)

class Word:
  def __init__(self, word, position=None):
    (self.word, self.canonical, self.canonicalCap, self.punct) = canonicalize(word)
    if self.punct or self.word=="":
      self.soundex=""
    else:
      self.soundex=soundex.soundex(self.word)
    if position:
      self.positions=[position]
    else:
      self.positions=[]

  def __str__(self):
    return self.canonical


  def pretty(self, pos, evanescent=False):
    global stream
    # autovivify position list, if this is not an evanescent operation (ex., a word currently under the cursor or being suggested)
    if not evanescent and not pos in self.positions and pos < len(stream) and stream[pos]==self:
      self.positions.append(pos)
    if pos==0 or stream[min(len(stream)-1, pos-1)].punct:
      return self.canonicalCap
    return self.canonical

  def predictNext(self, limit=None):
    nextTokenCounts={}
    dprint(f"positions for {self.word}: {self.positions}")
    for pos in self.positions:
      if pos is not None:
        if pos+1<len(stream):
          token=stream[pos+1].word
        else:
          token=" "
        nextTokenCounts[token]=nextTokenCounts.get(token, 0)+1
    scoreboard=[(nextTokenCounts[k], k) for k in nextTokenCounts]
    dprint(f"scoreboard before sorting:{scoreboard}")
    scoreboard.sort()
    if limit is not None and len(scoreboard)>limit:
      scoreboard=scoreboard[:limit]
    dprint(f"scoreboard for {self.word}: {scoreboard}")
    return scoreboard

def autovivifyLexicon(w):
  global lexicon
  word=Word(w)
  if word.word in lexicon:
    word=lexicon[word.word]
  else:
    lexicon[word.word]=word
  soundexMatches=sLexicon.get(word.soundex, [])
  if word.word not in soundexMatches:
    sLexicon[word.soundex]=soundexMatches+[word.word]
  return word

def refreshTopPositionCount():
  global lexicon, topPositionCount
  # ensure all positions in the lexicon are correct
  topPositionCount=0
  for word in lexicon:
    w=lexicon[word]
    dprint(f"positions before refresh: {w.positions}")
    w.positions=list(set(w.positions)) # remove duplicates first
    dprint(f"positions after deduplicate: {w.positions}")
    for pos in w.positions:
      if (
          pos is None or pos < 0 or pos >= len(stream) # invalid positions
          or stream[pos] != w # not matching
        ):
        w.positions.remove(pos) 
    dprint(f"positions after removing non-matching: {w.positions}")
    w.positions.sort()
    dprint(f"positions after sort: {w.positions}")
    if topPositionCount < len(w.positions):
      topPositionCount = len(w.positions)
  dprint(f"topPositionCount: {topPositionCount}")

def addToStream(w, index=None):
  global stream, topPositionCount
  dprint(f"addToStream(w={w}, index={index})")
  word=autovivifyLexicon(w)
  word.positions.append(index)
  if index is None or index==len(stream):
    stream.append(word)
  else:
    stream.insert(index, word)
  if len(word.positions)>topPositionCount:
    topPositionCount=len(word.positions)

def streamSubstitute(pos, new):
  global stream, topPositionCount
  old=stream[pos]
  if pos in old.positions:
    old.positions.remove(pos)
  word=autovivifyLexicon(new)
  word.positions.append(pos)
  stream[pos]=word
  if len(word.positions)>topPositionCount:
    topPositionCount=len(word.positions)

def importText(s):
  s=s.lower()
  for punct in supportedPunct.values():
    s=s.replace(punct, " "+punct+" ")
  for w in s.split(" "):
    if w is not None and w!="":
      addToStream(w)

## UI setup
tk = tkinter.Tk()
scrollFont=font.Font(family=scrollFontFamily, name="scrollFont", size=int(scrollFontSize))
sidebarFont=font.Font(family=scrollFontFamily, name="sidebarFont", size=int(scrollFontSize/sidebarScaleFactor))
currentFont=font.Font(family=scrollFontFamily, name="currentFont", size=int(scrollFontSize*currentScaleFactor))

class DocumentView(scrolledtext.ScrolledText):
  def __init__(self, master, **kw):
    self.populated=False
    super().__init__(master, **kw)
  def highlight_matches(self, highlights, tag, **kw):
    for line in range(0, int(self.index('end-1c').split('.')[0])):
      lineValue=self.get(f"{line+1}.0", f"{line+1}.end")
      for highlight in highlights:
        offset=0
        pos=lineValue[offset:].lower().find(highlight.lower())
        while pos>=0:
          self.tag_add(tag, f"{line+1}.{pos+offset+1}", f"{line+1}.{pos+offset+len(highlight)}")
          offset+=pos+offset+len(highlight)
          pos=lineValue[offset:].lower().find(highlight.lower())
    self.tag_config(tag, **kw)
  def regenerate(self, highlights=None):
    dprint(f"regenerating stream {len(stream)}w")
    self.configure(state="normal")
    self.delete(1.0, END)
    text="".join([stream[pos].pretty(pos) for pos in range(0, len(stream))])
    dprint(f"text: {text}")
    splitText=text.split("\n")
    for line in range(0, len(splitText)):
      self.insert(f"{line+1}.0", splitText[line]+"\n")
    if highlights is not None:
      self.highlight_matches(highlights, "highlighted", background="green")
    for item in lexicon:
      word=lexicon[item]
      scale=len(word.positions)/max(topPositionCount, len(word.positions))
      index=int((len(rainbow)-1)*scale)
      dprint(f"color index: {index} / {rainbow}({len(rainbow)})", level=2)
      color = rainbow[index]
      self.highlight_matches([word.canonical, word.canonicalCap], color, foreground=color)
    self.configure(state="disabled")

class CurrentView(tkinter.Label):
  def __init__(self, master, **kw): # Mandatory args: scroll, sidebar
    global stream
    self.scroll=kw["scroll"]
    del kw["scroll"]
    self.sidebar=kw["sidebar"]
    del kw["sidebar"]
    self.suggest=None
    if "suggest" in kw:
      self.suggest=kw["suggest"]
      del kw["suggest"]
    
    self.pos=len(stream)
    super().__init__(master, **kw)
  def regenerate(self):
    self.autovivify_accursed()
    text=stream[self.pos].pretty(self.pos)
    self.configure(text=text)
    self.scroll.regenerate(highlights=[text])
    self.sidebar.regenerate(highlights=[text])
    if self.suggest is not None:
      self.suggest.regenerate(self.pos)
  def autovivify_accursed(self):
    global stream
    # autovivify the accursed portion of the stream
    sl=len(stream)
    self.pos=min(self.pos, sl)
    if self.pos == sl and stream[self.pos-1].word!="":
      addToStream("")
    if self.pos>=len(stream):
      self.pos=len(stream)-1
  def next(self, event):
    self.pos+=1
    self.regenerate()
  def prev(self, event):
    self.pos-=1
    self.regenerate()
  def sanitizePosition(self):
    w=stream[self.pos]
    if self.pos not in w.positions:
      w.positions.append(self.pos)
      if None in w.positions:
        w.positions.remove(None)
      w.positions.sort()
  def nextMatch(self, event):
    self.sanitizePosition()
    w=stream[self.pos]
    self.pos=w.positions[(w.positions.index(self.pos)+1)%len(w.positions)]
  def prevMatch(self, event):
    self.sanitizePosition()
    w=stream[self.pos]
    self.pos=w.positions[(w.positions.index(self.pos)-1)%len(w.positions)]
  def nextSuggestion(self, event):
    if self.suggest is not None:
      idx=self.suggest.selectedSuggestion or 0
      streamSubstitute(self.pos, self.suggest.scoreboard[(idx+1)%len(self.suggest.scoreboard)][1])
      self.regenerate()
  def prevSuggestion(self, event):
    if self.suggest is not None:
      idx=self.suggest.selectedSuggestion or 0
      streamSubstitute(self.pos, self.suggest.scoreboard[(idx-1)%len(self.suggest.scoreboard)][1])
      self.regenerate()
  def keyHome(self, event):
    self.pos=0
    self.regenerate()
  def keyEnd(self, event):
    self.pos=len(stream)-1
    self.regenerate()
  def handle_key(self, event):
    global stream
    dprint(f"got event: {event}, current pos {self.pos}, keysym {event.keysym} char {event.char}")
    self.autovivify_accursed()
    keysym=event.keysym
    if keysym == "BackSpace":
      w=stream[self.pos].word
      if ""==w:
        stream.pop(self.pos)
        self.pos-=1
      else:
        streamSubstitute(self.pos, w[:-1])
    else:
      if "space"==keysym:
        self.pos+=1
        refreshTopPositionCount()
      elif keysym in supportedPunct:
        dprint("isPunct=True")
        char=keysym
        if event.char:
          char=event.char
        self.pos+=1
        addToStream(supportedPunct[keysym], self.pos)
        self.pos+=1
        addToStream("", self.pos)
      else:
        dprint("isPunct=False")
        streamSubstitute(self.pos, stream[self.pos].word+keysym)
    self.regenerate()

class SuggestView(tkinter.Text):
  def __init__(self, master, **kw):
    self.selectedSuggestion=None
    super().__init__(master, **kw)
  def regenerate(self, pos, n=5):
    scoreboard=stream[max(pos-1, 0)].predictNext()
    word=stream[pos].word
    if "" != word:
      if scoreboard:
        scoreboard2=[w for w in scoreboard if(w[1].find(word) == 0)] 
        for w in scoreboard:
          if w not in scoreboard2:
            scoreboard2.append(w)
        scoreboard=scoreboard2
    if len(scoreboard) > n:
      scoreboard=scoreboard[:n]
    self.scoreboard=scoreboard
    self.displayScores(pos)
  def displayScores(self, pos=None):
    scoreboard=self.scoreboard
    self.configure(state="normal")
    self.delete(1.0, END)
    for line in range(0, len(scoreboard)):
      self.insert(f"{line+1}.0", f"{scoreboard[line][1]}\t\t\t\t\t\t{scoreboard[line][0]}\n")
      if pos is not None:
        if scoreboard[line][1]==stream[pos].word:
          self.selectedSuggestion=line
      if self.selectedSuggestion is not None:
        if line==self.selectedSuggestion:
          self.tag_add("selectedSuggestion", f"{line+1}.0", f"{line+1}.end")
        self.tag_configure("selectedSuggestion", foreground="green")
    self.configure(state="disabled")

frame = tkinter.Frame(tk, relief=RIDGE, borderwidth=2)
frame.pack(fill=BOTH, expand=TRUE)

sidebar = DocumentView(frame, font=sidebarFont, width=scrollWidth)
sidebar.pack(fill=Y, expand=TRUE, side=LEFT)

frame2 = tkinter.Frame(frame, relief=RIDGE, borderwidth=1)

scroll = DocumentView(frame2, font=scrollFont, width=scrollWidth)
scroll.pack(fill=Y, expand=TRUE)

suggest = SuggestView(frame2, font=scrollFont, borderwidth=2, height=5) 

current = CurrentView(frame2, font=currentFont, scroll=scroll, suggest=suggest, sidebar=sidebar, borderwidth=2, background="green")
current.pack(fill=X, expand=TRUE, side=BOTTOM)
suggest.pack(fill=X, expand=TRUE, side=BOTTOM)


frame2.pack(fill=BOTH, expand=TRUE)

for key in range(0, 9):
  current.bind(f"<KeyRelease-{key}>", current.handle_key)
for key in range(0, 26):
  current.bind(f"<KeyRelease-{alpha[key]}>", current.handle_key)
for key in ["space", "BackSpace"] + list(supportedPunct.keys()):
  current.bind(f"<KeyPress-{key}>", current.handle_key)
current.bind("<KeyRelease-Escape>", lambda e: sys.exit(0))
current.bind("<KeyPress-Right>", current.next)
current.bind("<KeyPress-Left>", current.prev)
current.bind("<KeyPress-Control_R>", current.nextMatch)
current.bind("<KeyPress-Control_L>", current.prevMatch)
current.bind("<KeyPress-Alt_R>", current.nextSuggestion)
current.bind("<KeyPress-Alt_L>", current.prevSuggestion)
current.bind("<KeyRelease-Home>", current.keyHome)
current.bind("<KeyRelease-End>", current.keyEnd)

if len(sys.argv)>1:
  importText(open(sys.argv[1], "r").read())
else:
  importText("""WELCOME TO SHORTHAND

Shorthand is a text editor inspired by Ted Nelson's /Jot/, a "text language for editing". It does not store text as a contiguous string, but as pointers to a stream of words. Shorthand understands enough of the structure of english to operate only on words and punctuation, and produce sentences from there.

This means it's also well-suited to exposing information about language on the scale of words: every word is colored based on its frequency in the current document.

The currently selected (or accursed) word is in the green panel below. Every instance of the accursed word in the document is highlighted in green. Type letters, and you add to the accursed word. Backspace deletes from the end of the word. Press space to go to the next word. Punctuation is always its own word, and capitalizes the next word.

Press home or end to get to the beginning or end of the document respectively. Arrow keys circulate through words. Left and right control keys circulate between different instances of the accursed word. Left and right alt circulate through suggestions. 

Shorthand is also inspired by Jef Raskin's work on the Canon Cat; expect to see much more of that influence in the future.""")

current.regenerate()
current.focus_set()
tk.mainloop()
